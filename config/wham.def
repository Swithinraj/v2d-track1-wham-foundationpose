Bootstrap: docker
From: yusun9/wham-vitpose-dpvo-cuda11.3-python3.9:latest

%labels
    org.opencontainers.image.source https://github.com/yohanshin/WHAM
    org.opencontainers.image.revision 2b54f7797391c94876848b905ed875b154c4a295
    org.opencontainers.image.description "WHAM runtime for NVIDIA V2D Track 1 human baseline"

%environment
    export CUDA_HOME=/usr/local/cuda
    export PYTHONUNBUFFERED=1
    export PYOPENGL_PLATFORM=egl

%post
    # The upstream image carries GUI OpenCV. Under Apptainer --nv it resolves
    # the host libGLX, whose glibc requirement is newer than this image. WHAM's
    # video pipeline needs no GUI backend, so use the ABI-independent headless
    # wheel instead.
    python -m pip uninstall -y opencv-python opencv-contrib-python || true
    python -m pip install --no-cache-dir --force-reinstall --no-deps \
        opencv-python-headless==4.8.1.78

%test
    python -c "import cv2, gdown, joblib, smplx, torch; print('wham_runtime_imports=pass', torch.__version__)"

%runscript
    exec "$@"
