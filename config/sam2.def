Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel

# Build from the repository root (pipeline/setup/build_containers.sh): %files paths are relative.
%labels
    org.opencontainers.image.source https://github.com/nvidia-isaac/video_to_data
    org.opencontainers.image.revision 193382a184308f6800331f3db829f76dc4294cfe
    org.opencontainers.image.description "V2D SAM2 input preparation for Track 1"

%files
    third_party/video_to_data/reconstruction/modules/v2d_common /workspace/v2d_common
    third_party/video_to_data/reconstruction/modules/v2d_mv /workspace/v2d_mv
    third_party/video_to_data/reconstruction/modules/v2d_sam2 /workspace/v2d_sam2

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y libgl1 libglib2.0-0 git zip
    rm -rf /var/lib/apt/lists/*
    pip install -e "/workspace/v2d_common[io]" -e /workspace/v2d_mv -e /workspace/v2d_sam2/lib

%environment
    export PYTHONUNBUFFERED=1

%test
    python -c "import v2d.sam2.lib.download_weights"

%runscript
    exec "$@"

